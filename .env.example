# OpenRouter (required)
OPENROUTER_API_KEY=

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Music Creation Agent model (LLM orchestration layer)
MUSIC_AGENT_MODEL=google/gemini-3.1-flash-lite
# Max tokens for the structured song payload
AGENT_MAX_TOKENS=2000

# Outro agent model (post-playback conversation message)
MUSIC_OUTRO_MODEL=google/gemini-3.1-flash-lite
# Max tokens for the outro message
MUSIC_OUTRO_MAX_TOKENS=100
# Outbound HTTP timeout for the outro agent in seconds
MUSIC_OUTRO_TIMEOUT_SECONDS=20

# Lyria music generation model
LYRIA_MODEL=google/lyria-3-clip-preview

# Session memory (Redis). Empty/unavailable Redis falls back to in-memory storage.
REDIS_URL=redis://localhost:6379/0

# Assistant session TTL in seconds (30 minutes default)
SESSION_TTL_SECONDS=1800

# Generated audio output directory
OUTPUT_DIR=output

# Structured log level
LOG_LEVEL=INFO

# Outbound HTTP timeouts in seconds
HTTP_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=60
